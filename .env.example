# ── Required ────────────────────────────────────────────────────────────────
# Used to derive the AES-256-GCM key that encrypts TOTP (2FA) secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

# REQUIRED for email delivery of verification codes (https://brevo.com).
# Without it, /api/auth/code returns 503 — codes are NEVER printed or returned.
BREVO_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# Verified sender for the verification emails.
BREVO_SENDER_EMAIL=aether.verify@outlook.com
BREVO_SENDER_NAME=Aether

# Cloudflare Turnstile bot protection. If TURNSTILE_SECRET_KEY is set, the
# backend requires a valid Turnstile token on signup/code requests. Set the
# public site key so the frontend renders the widget. Both must be set together.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Media queue (Turso). Uploaded chat images land here and are mirrored to the
# local drive (D:\Aether-Images-and-media) by scripts/sync-media.mjs. Without
# these, image uploads return 503 (text chat still works).
TURSO_URL=https://your-db.turso.io
TURSO_AUTH_TOKEN=

# Local media sync (used by your PC via `node --env-file=.env.local scripts/sync-media.mjs`).
MEDIA_ROOT=D:\Aether-Images-and-media
MEDIA_MAX_GB=80
MEDIA_PURGE_AFTER_SYNC=false

# Cloudflare Calls TURN — makes voice/screen-share calls work behind strict
# NATs. Create a TURN key in the Cloudflare dashboard (Realtime → TURN keys),
# then set its id + API token as Worker SECRETS (not env vars). Without them
# calls fall back to STUN-only, which works on most home networks.
TURN_KEY_ID=
TURN_KEY_API_TOKEN=

# Workers AI is configured via wrangler.toml ([[ai]] binding = "AI") and needs
# Workers AI enabled on your Cloudflare account. It powers automated NSFW
# screening of uploaded images; without it, screening is skipped entirely.

# Web Push (RFC 8030) — delivers notifications even when the chat window is
# closed. Generate a keypair with:
#   npx web-push generate-vapid-keys
# then set both values (public key can also be NEXT_PUBLIC so the client
# subscribes without a round-trip). Without these, push is skipped and only
# in-tab notifications work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
